# Copia esto a .env.local para trabajar en tu máquina, y cárgalo también en el
# proveedor cuando publiques. Los valores reales NO van en git.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project Settings -> API. Las dos son públicas: viajan al navegador y no dan
# acceso a nada por sí solas, porque todo pasa por RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# SUPABASE_SERVICE_ROLE_KEY va en tu .env.local y en ningún otro sitio.
#
# En el .env.local sí hace falta: los programas de scripts/ la leen de ahí y
# sin ella no pueden importar ni corregir nada. En el proveedor NO se carga
# nunca, porque la aplicación no la usa jamás y esa clave se salta RLS por
# completo: cada sitio donde esté es un sitio desde donde puede filtrarse.
#
# Por eso no aparece escrita abajo. Se añade a mano al .env.local.

# ---------------------------------------------------------------------------
# Tienda
# ---------------------------------------------------------------------------
# Número al que llegan los pedidos, con código de país y sin signos.
NEXT_PUBLIC_WHATSAPP=584121234567

# ---------------------------------------------------------------------------
# Lectura de las capturas de pedidos
# ---------------------------------------------------------------------------
# openrouter.ai -> Keys. Esta es privada: se usa solo en el servidor. Si le
# pusieras NEXT_PUBLIC_ delante, viajaría al navegador y cualquiera podría
# gastarla.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# Opcional. Sin esto usa el primero de la lista de respaldo, que es gratuito.
# Para pasar a uno de pago, se cambia solo esta línea.
MODELO_LECTOR=google/gemma-4-26b-a4b-it:free
